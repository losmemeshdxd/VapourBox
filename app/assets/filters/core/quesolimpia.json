{
  "$schema": "https://vapourbox.app/schemas/filter-v1.json",
  "id": "quesolimpia",
  "version": "1.0.0",
  "name": "QuesoLimpia",
  "description": "Restauración Maestra 100% Automática de VHS",
  "longDescription": "Motor profesional auto-calibrado de 7 cuadros (N-3 a N+3): erradica el 100% de la lluvia y dropouts de cinta sin alterar gradientes de luz suaves ni opacar letras o generar manchas.",
  "category": "cleanup",
  "icon": "cleaning_services",
  "order": 4,
  "dependencies": {
    "vs_plugins": [
      "libtemporalmedian.dll",
      "libmvtools.dll"
    ]
  },
  "methods": [
    {
      "id": "quesolimpia",
      "name": "QuesoLimpia",
      "description": "Restauración Automática de VHS",
      "function": "quesolimpia.QuesoLimpia",
      "parameters": [
        "strength",
        "showMask"
      ]
    }
  ],
  "parameters": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "ui": {
        "hidden": true
      }
    },
    "strength": {
      "type": "integer",
      "default": 100,
      "min": 10,
      "max": 100,
      "step": 5,
      "ui": {
        "label": "Fuerza de Restauración",
        "description": "Potencia de erradicación de lluvia y dropouts de cinta en 7 cuadros (100% = máxima limpieza automática).",
        "widget": "slider",
        "unit": "%"
      }
    },
    "showMask": {
      "type": "enum",
      "default": "off",
      "options": [
        "off",
        "repair",
        "side_by_side"
      ],
      "ui": {
        "label": "Diagnóstico Visual",
        "description": "Ver en tiempo real los defectos que están siendo restaurados.",
        "widget": "dropdown",
        "optionLabels": {
          "off": "Desactivado (Video limpio)",
          "repair": "Ver Defectos Eliminados",
          "side_by_side": "Comparar Antes / Después"
        }
      }
    }
  }
}
