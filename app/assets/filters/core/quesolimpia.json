{
  "$schema": "https://vapourbox.app/schemas/filter-v1.json",
  "id": "quesolimpia",
  "version": "1.0.0",
  "name": "QuesoLimpia",
  "description": "Elimina automáticamente polvo, manchas y puntitos de VHS o película",
  "longDescription": "Limpieza automática inteligente basada en compensación de movimiento y mediana temporal.",
  "category": "cleanup",
  "icon": "cleaning_services",
  "order": 4,
  "dependencies": {
    "vs_plugins": [
      "libtemporalmedian.dll",
      "libmvtools.dll"
    ]
  },
  "methods": [
    {
      "id": "quesolimpia",
      "name": "QuesoLimpia",
      "description": "Limpieza automática",
      "function": "quesolimpia.QuesoLimpia",
      "parameters": [
        "strength",
        "threshold",
        "showMask"
      ]
    }
  ],
  "parameters": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "ui": {
        "hidden": true
      }
    },
    "strength": {
      "type": "integer",
      "default": 80,
      "min": 10,
      "max": 100,
      "step": 5,
      "ui": {
        "label": "Fuerza de Limpieza",
        "description": "Intensidad con la que se eliminan los puntos de suciedad.",
        "widget": "slider",
        "unit": "%"
      }
    },
    "threshold": {
      "type": "integer",
      "default": 12,
      "min": 2,
      "max": 30,
      "step": 1,
      "ui": {
        "label": "Sensibilidad",
        "description": "Sensibilidad de detección (menor número detecta puntos más pequeños).",
        "widget": "slider"
      }
    },
    "showMask": {
      "type": "enum",
      "default": "off",
      "options": [
        "off",
        "repair"
      ],
      "ui": {
        "label": "Diagnóstico Visual",
        "description": "Ver en tiempo real los puntos detectados.",
        "widget": "dropdown",
        "optionLabels": {
          "off": "Desactivado (Video limpio)",
          "repair": "Ver Puntos Detectados (Rojo)"
        }
      }
    }
  }
}
